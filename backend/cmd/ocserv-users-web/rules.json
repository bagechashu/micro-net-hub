{
  "rules": [
    {
      "name": "public_dns",
      "rules": [
        { "ip": "8.8.8.8", "protocol": "tcp", "port": 53 },
        { "ip": "1.1.1.0/24", "protocol": "udp" }
      ]
    },
    {
      "name": "input_rules",
      "rules": [
        { "ip": "10.12.0.11", "protocol": "tcp", "port": 443 }
      ]
    },
    {
      "name": "admin_access",
      "rules": [
        { "ip": "10.12.0.11/32", "protocol": "tcp", "port": 22 },
        { "ip": "10.12.0.216", "protocol": "tcp", "port": 22 },
        { "ip": "10.12.0.0/16", "protocol": "icmp", "port": 22 },
        { "ip": "8.8.4.4", "protocol": "udp" }
      ]
    },
    {
      "name": "user_network",
      "rules": [{ "ip": "10.12.0.0/16", "protocol": "tcp" }]
    },
    {
      "name": "dev_rules",
      "rules": [
        { "ip": "192.168.1.0/24", "protocol": "tcp", "port": 8080 },
        { "ip": "192.168.2.0/24", "protocol": "udp", "port": 53 }
      ]
    }
  ],
  "users": [
    {
      "name": "admins",
      "users": ["user1", "admin1"],
      "rule_ref": "admin_access"
    },
    {
      "name": "developers",
      "users": ["user1", "user2", "dev1", "dev2"],
      "rule_ref": "user_network"
    },
    {
      "name": "testers",
      "users": ["tester1"],
      "rule_ref": "dev_rules"
    }
  ],
  "public_rule_ref": "public_dns",
  "input_chain": [
    { 
      "name": "input",
      "src_ip": ["10.12.0.0/16"],
      "rule_ref": "input_rules"
    }
  ]
}
